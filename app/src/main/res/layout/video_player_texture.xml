<?xml version="1.0" encoding="utf-8"?>
<!--
  PlayerView backed by a TextureView (not the default SurfaceView). A SurfaceView lives in its own
  native layer and ignores Compose graphicsLayer transforms, so during the viewer's swipe-dismiss
  the video stayed at full size while everything else animated away (the "thumbnail pop"). A
  TextureView renders into the view hierarchy and honors scale/translation/alpha. resize_mode=fit
  preserves the video's aspect ratio (letterboxed), matching PlayerView's default behavior.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:resize_mode="fit" />
